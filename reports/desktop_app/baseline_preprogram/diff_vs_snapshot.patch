+/* 2. Shell layout offset. PlatformShell publishes --shell-top on <html>: 32 px title strip in the desktop app
+   + 24 px connection banner while ui-api is down; 0 in a browser without a banner. The page flows below it and
+   the app's fixed/sticky chrome offsets by var(--shell-top, 0px). */
+:root { --shell-top: 0px; }
+body.terminal { padding-top: var(--shell-top); }
+
+/* 3. Title strip (desktop app only): overlay title bar, 32 px like the native macOS 26 title bar. The traffic lights
+   sit at the left: with the shell's inset x = 14 the zoom button ends at 74 px, so content starts at 84 px. */
+.sd-strip {
+  position: fixed; top: 0; left: 0; right: 0;
+  display: flex; align-items: center; padding: 0 6px 0 84px;
+  background: #020304; border-bottom: 1px solid var(--t-border);
+  font-family: var(--t-mono); font-size: 10px; line-height: 1; letter-spacing: .08em;
+  color: var(--t-muted); white-space: nowrap; overflow: hidden;
+  user-select: none; -webkit-user-select: none; cursor: default;
+  font-variant-numeric: tabular-nums;
+}
+.sd-strip-brand { display: flex; align-items: center; gap: 7px; height: 100%; padding: 0 12px 0 2px; }
+.sd-mark { display: inline-block; width: 7px; height: 7px; background: var(--t-amber); transform: rotate(45deg);
+  box-shadow: 0 0 8px rgba(255, 176, 0, .45); flex: none; }
+.sd-wordmark { font-family: var(--t-display); font-weight: 700; font-size: 11px; letter-spacing: .26em; color: var(--t-amber); }
+.sd-strip-seg { display: flex; align-items: center; gap: 7px; height: 100%; padding: 0 11px; border-left: 1px solid var(--t-border); }
+.sd-strip-page { min-width: 0; overflow: hidden; }
+.sd-strip-code { font-family: var(--t-display); font-weight: 700; font-size: 11.5px; letter-spacing: .14em; color: var(--t-bright); }
+.sd-strip-label { color: var(--t-muted); text-transform: uppercase; letter-spacing: .12em; overflow: hidden; text-overflow: ellipsis; }
+.sd-strip-drag { flex: 1; align-self: stretch; min-width: 24px; }
+.sd-strip-k { color: var(--t-dim); font-size: 9px; letter-spacing: .16em; }
+.sd-strip-dim { color: var(--t-dim); letter-spacing: .08em; }
+.sd-strip-detail { text-transform: uppercase; font-size: 9px; letter-spacing: .12em; }
+.sd-strip-last { padding-right: 6px; }
+.sd-chip { display: inline-flex; align-items: center; height: 16px; padding: 0 6px; border: 1px solid var(--t-border-hi);

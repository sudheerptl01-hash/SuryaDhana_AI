/* 2. Shell layout offset. PlatformShell publishes --shell-top on <html>: 32 px title strip in the desktop app
   + 24 px connection banner while ui-api is down; 0 in a browser without a banner. The page flows below it and
   the app's fixed/sticky chrome offsets by var(--shell-top, 0px). */
:root { --shell-top: 0px; }
body.terminal { padding-top: var(--shell-top); }

/* 3. Title strip (desktop app only): overlay title bar, 32 px like the native macOS 26 title bar. The traffic lights
   sit at the left: with the shell's inset x = 14 the zoom button ends at 74 px, so content starts at 84 px. */
.sd-strip {
  position: fixed; top: 0; left: 0; right: 0;
  display: flex; align-items: center; padding: 0 6px 0 84px;
  background: #020304; border-bottom: 1px solid var(--t-border);
  font-family: var(--t-mono); font-size: 10px; line-height: 1; letter-spacing: .08em;
  color: var(--t-muted); white-space: nowrap; overflow: hidden;
  user-select: none; -webkit-user-select: none; cursor: default;
  font-variant-numeric: tabular-nums;
}
.sd-strip-brand { display: flex; align-items: center; gap: 7px; height: 100%; padding: 0 12px 0 2px; }
.sd-mark { display: inline-block; width: 7px; height: 7px; background: var(--t-amber); transform: rotate(45deg);
  box-shadow: 0 0 8px rgba(255, 176, 0, .45); flex: none; }
.sd-wordmark { font-family: var(--t-display); font-weight: 700; font-size: 11px; letter-spacing: .26em; color: var(--t-amber); }
.sd-strip-seg { display: flex; align-items: center; gap: 7px; height: 100%; padding: 0 11px; border-left: 1px solid var(--t-border); }
.sd-strip-page { min-width: 0; overflow: hidden; }
.sd-strip-code { font-family: var(--t-display); font-weight: 700; font-size: 11.5px; letter-spacing: .14em; color: var(--t-bright); }
.sd-strip-label { color: var(--t-muted); text-transform: uppercase; letter-spacing: .12em; overflow: hidden; text-overflow: ellipsis; }
.sd-strip-drag { flex: 1; align-self: stretch; min-width: 24px; }
.sd-strip-k { color: var(--t-dim); font-size: 9px; letter-spacing: .16em; }
.sd-strip-dim { color: var(--t-dim); letter-spacing: .08em; }
.sd-strip-detail { text-transform: uppercase; font-size: 9px; letter-spacing: .12em; }
.sd-strip-last { padding-right: 6px; }
.sd-chip { display: inline-flex; align-items: center; height: 16px; padding: 0 6px; border: 1px solid var(--t-border-hi);
  font-size: 9.5px; font-weight: 600; letter-spacing: .14em; color: var(--t-muted); }
.sd-chip.is-open { color: var(--t-green); border-color: rgba(22, 217, 138, .55); background: rgba(22, 217, 138, .08); }
.sd-chip.is-pre { color: var(--t-amber); border-color: rgba(255, 176, 0, .55); background: rgba(255, 176, 0, .08); }
.sd-clock { color: var(--t-bright); font-weight: 600; font-size: 11.5px; letter-spacing: .06em; }
.sd-svc { display: inline-flex; align-items: center; gap: 5px; font-size: 9px; letter-spacing: .14em; color: var(--t-muted); }
.sd-svc + .sd-svc { margin-left: 4px; }
.sd-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--t-dim); flex: none; }
.sd-dot.is-up { background: var(--t-green); box-shadow: 0 0 5px rgba(22, 217, 138, .7); }
.sd-dot.is-down { background: var(--t-red); box-shadow: 0 0 6px rgba(255, 77, 94, .8); animation: t-pulse 1.2s ease-in-out infinite; }
.sd-newbuild { margin-left: 4px; height: 18px; padding: 0 8px; border: none; background: var(--t-amber); color: #05070a;
  font-family: var(--t-mono); font-size: 9.5px; font-weight: 700; letter-spacing: .14em; cursor: pointer;
  animation: sd-attn 2.4s ease-in-out infinite; }
.sd-newbuild:hover { background: #ffc233; }
@keyframes sd-attn { 0%, 100% { box-shadow: 0 0 0 0 rgba(255, 176, 0, .0); } 50% { box-shadow: 0 0 0 3px rgba(255, 176, 0, .22); } }

/* 4. Connection banner (both modes) and the browser "new build" pill. */
.sd-banner {
  position: fixed; left: 0; right: 0; display: flex; align-items: center; gap: 12px; padding: 0 8px 0 0;
  font-family: var(--t-mono); font-size: 10px; letter-spacing: .1em; white-space: nowrap; overflow: hidden;
  border-bottom: 1px solid; animation: sd-banner-in .18s ease-out both;
}
.sd-banner.is-down { background: #170609; color: #ff8a94; border-color: rgba(255, 77, 94, .6); }
.sd-banner.is-ok { background: #03140d; color: var(--t-green); border-color: rgba(22, 217, 138, .5); }
.sd-banner-tag { align-self: stretch; display: flex; align-items: center; padding: 0 10px; font-weight: 700;
  letter-spacing: .16em; color: #05070a; }
.sd-banner.is-down .sd-banner-tag { background: var(--t-red); }
.sd-banner.is-ok .sd-banner-tag { background: var(--t-green); }
.sd-banner-main { font-weight: 700; text-transform: uppercase; letter-spacing: .14em; }
.sd-banner-dim { color: var(--t-muted); }
.sd-banner-btn { height: 16px; padding: 0 8px; background: transparent; border: 1px solid currentColor; color: inherit;
  font: inherit; font-size: 9px; font-weight: 700; letter-spacing: .14em; cursor: pointer; }
.sd-banner-btn:hover { background: rgba(255, 77, 94, .15); }
@keyframes sd-banner-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
.sd-pill {
  position: fixed; right: 14px; bottom: 32px; display: flex; align-items: center; gap: 10px; padding: 0 4px 0 0;
  height: 26px; background: var(--t-panel); border: 1px solid rgba(255, 176, 0, .55); box-shadow: 0 10px 30px rgba(0, 0, 0, .55);
  font-family: var(--t-mono); font-size: 10px; letter-spacing: .1em; color: var(--t-text); animation: t-fade-up .3s ease-out both;
}
.sd-pill-tag { align-self: stretch; display: flex; align-items: center; padding: 0 9px; background: var(--t-amber); color: #05070a;
  font-weight: 700; letter-spacing: .16em; }
.sd-pill-btn { height: 18px; padding: 0 9px; background: transparent; border: 1px solid var(--t-amber); color: var(--t-amber);
  font: inherit; font-weight: 700; letter-spacing: .14em; cursor: pointer; }
.sd-pill-btn:hover { background: rgba(255, 176, 0, .14); }
.sd-pill-x { width: 18px; height: 18px; background: none; border: none; color: var(--t-dim); font: inherit; font-size: 13px; cursor: pointer; }
.sd-pill-x:hover { color: var(--t-text); }

/* 5. Boot gate: black (terminal token), the mark fades in only after 250 ms so a fast boot never blinks. */
.sd-gate { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--t-bg); }
.sd-gate-mark { display: flex; flex-direction: column; align-items: center; gap: 12px; opacity: 0;
  animation: sd-gate-in .45s ease-out .25s forwards; }
.sd-gate-word { display: flex; align-items: center; gap: 10px; font-family: var(--t-display); font-weight: 700; font-size: 12px;
  letter-spacing: .42em; color: var(--t-amber-dim); }
.sd-gate-bar { position: relative; width: 132px; height: 1px; overflow: hidden; background: var(--t-border); }
.sd-gate-bar::after { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 36%; background: var(--t-amber);
  animation: sd-gate-scan 1.1s ease-in-out infinite; }
.sd-gate-slow { margin-top: 6px; font-family: var(--t-mono); font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase;
  color: var(--t-muted); opacity: 0; animation: sd-gate-in .4s ease-out 8s forwards; }
@keyframes sd-gate-in { to { opacity: 1; } }
@keyframes sd-gate-scan { from { transform: translateX(-100%); } to { transform: translateX(380%); } }
@media (prefers-reduced-motion: reduce) {
  .sd-gate-mark { animation: none; opacity: 1; }
  .sd-gate-slow { animation: sd-gate-in 0s linear 8s forwards; }
  .sd-gate-bar::after, .sd-newbuild, .sd-dot.is-down, .sd-banner { animation: none; }
}

venv/

# ML artifacts
models/*.joblib
models/*.pkl
models/*.json
# Trained model binaries are reproducible from scripts/ (generate_oos_propensity.py etc.)
# and OOS predictions live in DuckDB — keep the heavy artifacts out of git.
services/ui-api/models/**/*.pkl
services/ui-api/models/**/*.json

# OS
.DS_Store
.gstack/

# Local DuckDB backups (multi-GB) — never commit
data/backups/
# ml-service trained artifacts (model + model card) — regenerated by training
services/ml-service/models/*.pkl

# NSE full-bhavcopy raw archive cache (re-downloadable; loaded into DuckDB nse_bhavcopy)
data/nse_bhavcopy/
data/nse_archive/

# Decision Desk paper ledger (runtime state)
data/decision_desk.db
reports/ml_labels/scores.parquet
data/reference/icici_security_master/

# Production UI build (UI_MODE=prod in start-local.sh)
ui/.next-prod/
# Static UI releases served by ui-api (scripts/build_ui.sh) and the builder's staging/lock dir
ui/dist/
ui/.build-ui/
data/price_alerts.json
data/ui_prefs.sqlite*
data/filing_alerts_seen.json
data/move_alerts_sent.json

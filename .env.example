# ── SuryaDhana .env.example ───────────────────────────────────────────────────
# Copy to .env and fill in. Placeholders only — NEVER commit real secrets.
# Groups: [LOGIN-CRITICAL] must be set for the broker to work; everything else
# has a sensible default in code and is optional.

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────
DUCKDB_PATH=data/market.duckdb

# ── Redis ───────────────────────────────────────────────────────────────────────
# The local stack binds redis-server to 127.0.0.1 (start-local.sh start_redis). Optional password (Wave 0.7, O-T10):
# set REDIS_PASSWORD here or in the Keychain (security add-generic-password -a "$USER" -s suryadhana-redis -w '<pw>');
# start-local.sh then starts Redis with requirepass and exports REDIS_URL=redis://:<pw>@127.0.0.1:6379/0 to the services.
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── ICICI Direct Breeze API [LOGIN-CRITICAL] ───────────────────────────────────
# App key/secret from https://api.icicidirect.com/ (apiuser portal).
ICICI_API_KEY=your-breeze-app-key
ICICI_API_SECRET=your-breeze-app-secret
# Session token is written automatically by the daily login job / Telegram /login.
ICICI_SESSION_TOKEN=
# Login identity used by scripts/daily_session_refresh.py (browser login):
# user id (mobile number or iDirect id) + the password/PIN of that login page.
ICICI_CLIENT_ID=your-icici-user-id
ICICI_PASSWORD=your-icici-password-or-pin
# Phone number ICICI texts OTPs to (last digits shown in Telegram prompts).
ICICI_MOBILE=9800000000
# Optional: Google-Authenticator setup key → fully unattended login (no SMS).
ICICI_TOTP_SECRET=
# 0 disables the 08:00 auto-login job.
ICICI_AUTO_LOGIN=1

# ── Telegram bot [LOGIN-CRITICAL for phone control] ────────────────────────────
# Create a bot via @BotFather; chat id = your user id (bot answers only this chat).
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ── Off-machine dead-man ping (strongly recommended) ──────────────────────────
# A free healthchecks.io check (Period 5 min, Grace 10 min). scripts/stack_watchdog.sh pings it every 2 min while
# the stack is healthy and <url>/fail when it is not, so you are told when this Mac is off, frozen or waiting at
# the FileVault screen (every other alert is sent FROM this Mac). Read on every watchdog run: no restart needed.
# Treat it like a password. Steps: docs/RUNBOOK_RESTORE.md 'Off-machine dead-man ping'.
HEALTHCHECK_PING_URL=
# Optional second heartbeat (Terminal v2 0.2): a SECOND healthchecks.io check (same Period 5 min / Grace 10 min) the
# watchdog pings on every run whatever the stack's state. It stops only when this Mac is off, asleep, at the FileVault
# screen or launchd no longer runs the watchdog: first check 'fail' while this one beats = stack down on a live Mac;
# both silent = the Mac is gone. Read on every watchdog run; shown by Telegram /status. Treat like a password.
HEALTHCHECK_WATCHDOG_URL=
# Off-machine backup target (Wave 0.1, O-T1): a mounted volume / rclone mount / external SSD. When set, the 02:15 job may
# run `scripts/db_backup.py --offsite` (copies tonight's .duckdb(.zst) + ui_prefs .sqlite + meta, sha256-verified, same rotation).
OFFSITE_BACKUP_DIR=

# ── Discord Alerts (optional — leave blank to disable) ─────────────────────────
DISCORD_WEBHOOK_URL=

# ── Decision Desk (paper) ──────────────────────────────────────────────────────
DESK_ENABLED=1
DESK_CAPITAL=500000
DESK_EQUITY_SHARE=0.66
DESK_AVOID_BULK_BUY_DAYS=0
DESK_LEDGER=data/decision_desk.db
# Broker cost profile for every backtest/ledger: icici_moneysaver | icici_prime_999 | ...
COST_PROFILE=icici_moneysaver

# ── Live ticks (Breeze websocket; OFF until the live spike passes) ─────────────
LIVE_TICKS=0
# Breeze websocket subscription cap (default 300, clamped 52..500). L-CAPACITY measured 540 tokens clean on one socket;
# 500 means fewer evictions when many pages are open, at more CPU on data-service's socket.io receive thread.
# LIVE_TICKS_MAX_SYMBOLS=300
# DuckDB memory cap (start-local.sh defaults it to 4GB natively; containers keep the 1.5GB code default)
# DUCKDB_MEMORY_LIMIT=4GB
TICK_PERSIST=1   # W6: persist live ticks to data/ticks/<date>/part-*.parquet (only acts when LIVE_TICKS=1)

# ── Evening shared snapshot (set automatically by master-controller jobs;
#    export manually only when running evening scripts by hand) ─────────────────
# SURYA_SNAPSHOT_PATH=data/snapshots/evening/evening-YYYYMMDD-HHMM.duckdb

# ── Master Controller ──────────────────────────────────────────────────────────
MASTER_CONTROLLER_URL=http://localhost:8008
PYTHON_BIN=/Users/you/Desktop/jupyter_env/bin/python
AUTOPILOT_ENABLED=false
AUTOPILOT_DEFAULT=false

# ── UI / ops ───────────────────────────────────────────────────────────────────
# prod = optimised build in ui/.next-prod (recommended); dev = hot reload.
UI_MODE=prod
UI_API_URL=http://localhost:8010
RESEARCH_ROOT=
NEWS_SCANNER_DIR=
NEWS_SCANNER_DEFAULT_EXCHANGE=NSE

# ── Market-data keys for the Commodity/Gold desk (free keys; optional) ─────────
FRED_API_KEY=
EIA_API_KEY=

# ── Trading Parameters (legacy 5-day system; autopilot OFF) ────────────────────
STOCK_UNIVERSE_PATH=data/FINAL_100_STOCKS.csv
MAX_PORTFOLIO_POSITIONS=5
HOLDING_PERIOD_DAYS=5
STOP_LOSS_PCT=0.02
TAKE_PROFIT_MULTIPLIER=1.0
MAX_POSITION_PCT=0.15
MAX_SECTOR_PCT=0.40
DAILY_LOSS_LIMIT_PCT=0.02
MAX_DRAWDOWN_PCT=0.20
EXECUTION_MODE=PAPER
INITIAL_EQUITY=10000
PAPER_PRICE_GUARD_PCT=0.05
PAPER_TRADES_DB=data/paper_trades.db
# PAPER ONLY guard (ui-api routers/execution.py): LIVE mode is refused, and a LIVE mode restored from
# paper_trades.db is switched back to PAPER at start, unless this is exactly 1. Leave it unset.
# EXECUTION_LIVE_ALLOWED=

# ── Local HTTP guard (shared/http_guard.py: ui-api, data-service, master-controller) ────────────────
# The services answer only to Host 127.0.0.1 / localhost / [::1]. Extra names, comma list, optional :port
# (a Tailscale Serve name, the Mac's LAN IP when UI_API_HOST=0.0.0.0, Docker service names):
# GUARD_ALLOWED_HOSTS=
# Extra browser origins allowed to send writes (comma list), e.g. https://mac.tailnet-x.ts.net
# GUARD_ALLOWED_ORIGINS=
# 1 = clients on other machines may write (only with a LAN bind; not recommended)
# GUARD_ALLOW_REMOTE_WRITES=
# Max concurrent /api/monitor/ws/monitor sockets (each holds a Redis connection and a thread)
# MONITOR_WS_MAX=32

# ── ML Parameters (legacy pipeline) ────────────────────────────────────────────
MIN_SIGNAL_CONFIDENCE=0.12
PREDICTION_HORIZON_DAYS=5
FEATURE_LOOKBACK_DAYS=60
ACTIVE_MODEL=
MODEL_ARTIFACT_DIR=
ML_WORKSPACE_MODEL_DIR=
MAX_FEATURE_AGE_BUSINESS_DAYS=5
BATCH_SIZE=200
GRID_FROM=
GRID_TO=

# ── Data service / pipeline knobs (defaults in shared/config.py) ───────────────
HISTORICAL_YEARS=5
DATA_DIR=data
DB_PATH=data/market.duckdb
DATABASE_URL=
DATA_JOBS_ENABLED=1
DATA_JOB_TIMEOUT_SECS=3600
ANALYTICS_SNAPSHOT_DIR=
BREEZE_CACHE_DIR=
REFERENCE_DIR=
SCRIPTS_DIR=
ALERTS_PATH=
ALPHA_ENGINE_PATH=
GOLD_LOG_ENABLED=1
GOLD_LOG_PATH=
NIFTY_POLL_INTERVAL=20
WATCHLIST_POLL_INTERVAL=60
WATCHLIST_POLL_CONCURRENCY=4
WATCHLIST_POLL_MAX_SYMBOLS=60

# ── Internal Service URLs (local defaults; Docker overrides via compose) ───────
DATA_SERVICE_URL=http://localhost:8001
DATA_SVC_URL=http://localhost:8001
FEAT_SVC_URL=http://localhost:8002
FEATURE_SERVICE_URL=http://localhost:8002
ML_SERVICE_URL=http://localhost:8003
RL_SERVICE_URL=http://localhost:8004
RISK_SERVICE_URL=http://localhost:8005
EXECUTION_SERVICE_URL=http://localhost:8006
MONITORING_SERVICE_URL=http://localhost:8007
RL_TRAINER_PATH=/app/scripts/rl_trainer.py

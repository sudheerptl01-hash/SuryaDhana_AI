# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────
DUCKDB_PATH=data/market.duckdb

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── ICICI Direct Breeze API ────────────────────────────────────────────────────
# Get from: https://api.icicidirect.com/
ICICI_API_KEY=
ICICI_API_SECRET=
ICICI_SESSION_TOKEN=

# ── Telegram Alerts ────────────────────────────────────────────────────────────
# Create a bot via @BotFather, then get the chat_id from /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading Parameters ─────────────────────────────────────────────────────────
STOCK_UNIVERSE_PATH=data/FINAL_100_STOCKS.csv
MAX_PORTFOLIO_POSITIONS=5
HOLDING_PERIOD_DAYS=5
STOP_LOSS_PCT=0.02
TAKE_PROFIT_MULTIPLIER=1.0
MAX_POSITION_PCT=0.15
MAX_SECTOR_PCT=0.40
DAILY_LOSS_LIMIT_PCT=0.02
MAX_DRAWDOWN_PCT=0.20

# ── ML Parameters ──────────────────────────────────────────────────────────────
MIN_SIGNAL_CONFIDENCE=0.12
PREDICTION_HORIZON_DAYS=5
FEATURE_LOOKBACK_DAYS=60

# ── Data ───────────────────────────────────────────────────────────────────────
HISTORICAL_YEARS=5

# ── Internal Service URLs (override for local dev without Docker) ──────────────
DATA_SERVICE_URL=http://localhost:8001
FEATURE_SERVICE_URL=http://localhost:8002
ML_SERVICE_URL=http://localhost:8003
RL_SERVICE_URL=http://localhost:8004
RISK_SERVICE_URL=http://localhost:8005
EXECUTION_SERVICE_URL=http://localhost:8006
MONITORING_SERVICE_URL=http://localhost:8007
